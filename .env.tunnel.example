# INEMEC SITE - Plantilla de variables de entorno
# Copiar a .env.tunnel y rellenar los valores reales. NO versionar .env.tunnel.

# ==============================================================================
# Cloudflare Tunnel
# ==============================================================================
# Crear el tunel en https://one.dash.cloudflare.com/ -> Networks -> Tunnels.
# Configurar un Public Hostname (Published application) apuntando a http://wordpress:80.
TUNNEL_TOKEN=

# ==============================================================================
# WordPress / MariaDB
# ==============================================================================
WP_DB_NAME=inemecco_wp74
WP_DB_USER=inemec_wp
WP_DB_PASSWORD=            # openssl rand -base64 18 | tr -d '/+=' | head -c 24
WP_DB_ROOT_PASSWORD=       # idem
WP_TABLE_PREFIX=wpvk_

# URL publica del sitio (las constantes pisan wp_options en runtime)
WP_HOME=https://site.inemec.com
WP_SITEURL=https://site.inemec.com

# ==============================================================================
# Backups (protocolo unificado Inemec.150)
# ==============================================================================
BACKUP_INTERVAL=600
BACKUP_RETENTION_DAYS=30
BACKUP_DESTINATIONS=sharepoint_jesus_corp
BACKUP_REMOTE_ROOT=Inemec.150/backups

# SMTP Office365 (compartido entre proyectos) — usado por backups y por WP Mail SMTP
ALERT_EMAIL=ing.tecnologia2@inemec.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=ti.automatizacion@inemec.com
SMTP_PASS=

# ==============================================================================
TZ=America/Bogota
